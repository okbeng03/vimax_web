# ============================================================
# ViMax Web — 环境变量示例模板
#
# 用法：复制为实际运行用的 .env 文件并填写真实值
#   cp .env.example backend/.env
#
# 后端配置由 backend/src/config.py 读取（pydantic-settings，
# 前缀 VIMAX_，env_file 为运行目录下的 .env，即 backend/.env）
#
# 所有变量均有默认值，仅需按需覆盖；未配置项不影响启动。
# ============================================================

# ── ViMax 执行环境 ──────────────────────────────────────────
# vimax_main 根目录（日志、workflow、ComfyUI view 等资源路径）
VIMAX_ROOT=/Users/wangchangbin/ai/ViMax-main
# 项目工作目录根（各项目 output/ 等子目录的上级）
WORKING_DIR_ROOT=/Users/wangchangbin/ai/vimax_ru

# ── 数据库 ──────────────────────────────────────────────────
# SQLite 连接串（相对 backend 运行目录）
DATABASE_URL=sqlite+aiosqlite:///data/vimax_web.db

# ── ComfyUI ─────────────────────────────────────────────────
# ComfyUI 服务地址（结果预览/回传拉取）
COMFYUI_BASE_URL=http://192.168.3.4:8188

# ── Vimax Scheduler（调度服务）──────────────────────────────
# 调度服务 base URL
SCHEDULE_SERVICE_URL=http://127.0.0.1:8001
# 调度服务鉴权 key（请求头 X-API-Key 携带）；留空则调度操作返回鉴权错误提示
SCHEDULE_API_KEY=

# ── 默认用户 ────────────────────────────────────────────────
DEFAULT_USERNAME=muze

# ── 服务 ────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=true

# ── CORS ────────────────────────────────────────────────────
# JSON 数组字符串，允许的前端来源
CORS_ORIGINS=["http://localhost:5173"]
